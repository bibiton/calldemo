{
  "name": "queue-call-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:seed": "pnpm --filter @qcs/api seed:local",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "check:hibernation": "node scripts/check-hibernation.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "lint": "pnpm check:hibernation && pnpm check:secrets && pnpm typecheck",
    "test": "pnpm check:hibernation && pnpm check:secrets && node --test scripts/check-hibernation.test.mjs scripts/check-secrets.test.mjs && bash scripts/lib.test.sh && pnpm -r test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "seed:demo": "node apps/api/scripts/seed-demo.mjs",
    "e2e:prod": "playwright test -c e2e/playwright.production.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
