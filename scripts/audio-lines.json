  "gapsMs": {
    "afterChime": 250,
    "prefixToNumber": 60,
    "letterToNumber": 30,
    "numberToEnding": 220,
    "recallToPrefix": 160,
    "betweenRepeats": 900
  },

  "templates": [
    { "key": "tpl.counter", "name": "趣味版（櫃台）", "use": "一般叫號、有櫃台",
      "steps": ["chime", "prefix", "number", "counter"] },
    { "key": "tpl.seat", "name": "趣味版（入座）", "use": "餐廳候位、不分櫃台",
      "steps": ["chime", "prefix", "number", "phrase.seat"] },
    { "key": "tpl.standard", "name": "標準版", "use": "不要趣味的門店",
      "steps": ["chime", "prefix.std", "number", "counter"] },
    { "key": "tpl.recall", "name": "重叫版", "use": "人員按「重叫」",
      "steps": ["chime", "recall", "prefix", "number", "counter"] },
    { "key": "tpl.skipped", "name": "過號提醒版", "use": "人員按「過號」後播一次",
      "steps": ["chime", "prefix.std", "number", "phrase.skipped"] }
