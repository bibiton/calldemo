# 複製成 config.staging.env / config.production.env 後填寫（這兩個檔不進 git）
DOMAIN=example.com                 # production 用 *.example.com；staging 會自動用 *.staging.example.com
ADMIN_EMAILS=you@company.com       # 總後台可登入的 email，逗號分隔（同時建成 platform_admin）
PUSH_CONTACT=mailto:you@company.com
# 選填：具 Access / Pages 網域權限的 token，有填才自動綁網域與建 Access 應用
# BOOTSTRAP_API_TOKEN=
