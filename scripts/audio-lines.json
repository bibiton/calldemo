{
  "_comment": "叫號語音台詞與參數。改這裡後重跑 scripts/gen-audio.py，只會重生有變動的檔案（以 文字+聲音參數 的雜湊判斷）。",
  "version": 1,
  "voice": { "name": "zh-TW-HsiaoChenNeural", "rate": "+6%", "pitch": "+3Hz" },
  "encode": { "codec": "mp3", "sampleRate": 24000, "channels": 1, "bitrate": "32k" },
  "trim": { "thresholdDb": -45, "keepLeadMs": 20, "keepTailMs": 40, "fadeOutMs": 20 },

  "numbers": {
    "from": 1,
    "to": 999,
    "combinedLetters": "ABCDEF",
    "fallbackLetters": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "suffix": "號"
  },
  "counters": { "from": 1, "to": 30, "pattern": "請到{n}號櫃台" },

  "phrases": [
    { "key": "phrase.seat",     "text": "請準備入座" },
    { "key": "phrase.seat2",    "text": "您的座位準備好囉，請跟著服務人員入座" },
    { "key": "phrase.desk",     "text": "請到櫃台辦理" },
    { "key": "phrase.recall1",  "text": "再叫一次～" },
    { "key": "phrase.recall2",  "text": "再提醒一次喔～" },
    { "key": "phrase.skipped",  "text": "已經過號囉，請洽櫃台人員，我們會盡快幫您安排" }
  ],

  "prefixPacks": [
    { "key": "standard",     "name": "標準版",     "note": "只說「來賓」，給不要趣味的門店" },
    { "key": "hungry",       "name": "餓了系",     "note": "餐飲限定（venue=food）" },
    { "key": "waited",       "name": "等很久系",   "note": "感謝耐心等候" },
    { "key": "anticipation", "name": "期待系",     "note": "好事要發生了" },
    { "key": "warm",         "name": "溫馨系",     "note": "歡迎與感謝；含生日（manualOnly，人員手動指定）" },
    { "key": "festival",     "name": "季節節慶系", "note": "天氣與節日，預設關閉，由門店在當季／當天開啟" }
  ],

  "prefixes": [
