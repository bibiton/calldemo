# 範本：~/.config/queue-call-system/cf.env（部署腳本唯一讀取的憑證檔；不放在 repo 內，ADR-049）
#   mkdir -p ~/.config/queue-call-system && cp scripts/config.example.env ~/.config/queue-call-system/cf.env
#   chmod 600 ~/.config/queue-call-system/cf.env      ← 權限不是 600 腳本會拒絕執行
# 只填值、不要把這個檔貼到聊天或截圖；腳本不會印出任何值。值含空白或逗號後有空白時請用雙引號包起來。
# 網域固定 jjoy.ai、環境固定 production、資源名稱固定 call-*-production（寫在 scripts/lib.sh，不在這裡設定）。

# 必填：部署用 API Token（權限見 docs/10 步驟 4）與帳號、zone
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_ZONE_ID=

# 總後台（call-admin.jjoy.ai）可登入的 email，逗號分隔。用於 Access policy、Worker 二次檢查、建立 platform_admin。
# 可以先留空：Access 與平台管理員會略過，業主提供名單後填上、重跑 bootstrap.sh（或 deploy.sh 同步名單）即可。
ACCESS_ALLOWED_EMAILS=

# 選填
# PUSH_CONTACT=                # Web Push 的 VAPID subject（mailto:…），未填用 ACCESS_ALLOWED_EMAILS 的第一位
# AE_API_TOKEN=                # 用量計量查 Analytics Engine SQL 的唯讀 token（Account Analytics Read），存成 Worker secret
# ACCESS_AUD=                  # Access 若手動設定：Application Audience (AUD) Tag
# ACCESS_TEAM_DOMAIN=          # Access 若手動設定：<team>.cloudflareaccess.com
