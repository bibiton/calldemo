{
  "name": "queue-call-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:seed": "pnpm --filter @qcs/api seed:local",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "check:hibernation": "node scripts/check-hibernation.mjs",
    "lint": "pnpm check:hibernation && pnpm typecheck",
    "test": "pnpm check:hibernation && node --test scripts/check-hibernation.test.mjs && pnpm -r test",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  }
}
